{
  "name": "pinnables",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:mcp": "npm run dev --workspace @pinnables/mcp-server",
    "dev:flowers": "npm run dev --prefix examples/flowers-website",
    "init:project": "tsx scripts/init-project.mts",
    "typecheck": "tsc --build --force"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
