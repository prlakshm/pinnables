# Companion service (`npm run dev:service`) reads these from the environment.
# It does not load this file automatically — export them or prefix the start command.

# Cursor Dashboard → Integrations / API Keys
CURSOR_API_KEY=

# Repo the local agent edits (the app under annotation). Defaults to the service cwd.
PINNABLES_PROJECT_DIR=

# HTTP listen port. Default 4573.
PINNABLES_PORT=4573

# local (default) edits files on this machine. cloud clones a remote repo on a Cursor VM.
PINNABLES_CURSOR_RUNTIME=local

# Model id. Default composer-2.5
PINNABLES_CURSOR_MODEL=composer-2.5

# Fast Composer is on unless set to 0.
PINNABLES_CURSOR_FAST=1

# 1 = always attach pin screenshots. 0 = never, except pen marks (those always attach).
# Unset: on for cloud, off for local text pins.
PINNABLES_SEND_IMAGES=

# If the Cursor API fails, fall back to spawning `claude` (or PINNABLES_AGENT_CMD).
PINNABLES_CURSOR_FALLBACK_LOCAL=0

# Force follow-ups onto this agent id. Otherwise the last id in ~/.pinnables/cursor-session.json.
PINNABLES_CURSOR_AGENT_ID=

# Optional Cursor API host. Default https://api.cursor.com
# CURSOR_API_BASE=

# Cloud runtime only
# PINNABLES_REPO_URL=
# PINNABLES_REPO_REF=
# PINNABLES_AUTO_CREATE_PR=0
# Prefer the caller's branch when set (default on). Set 0 to disable.
# PINNABLES_WORK_ON_CURRENT_BRANCH=1

# Override the local CLI fallback (shell; $PINNABLES_PROMPT and $PINNABLES_MESSAGE are set).
# PINNABLES_AGENT_CMD=

# Board + session storage root. Default ~/.pinnables
# PINNABLES_HOME=
